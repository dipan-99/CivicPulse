# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB Atlas connection string)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/civicpulse?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here_min_32_characters
JWT_EXPIRES_IN=7d

# CORS Allowed Origin (Frontend URL)
CLIENT_URL=http://localhost:5173

# Admin Credentials for Seed Script (Never commit real values)
ADMIN_EMAIL=admin@civicpulse.org
ADMIN_PASSWORD=AdminSecurePass123!
